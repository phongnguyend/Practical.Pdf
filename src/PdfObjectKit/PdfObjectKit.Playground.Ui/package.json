{
  "name": "pdfobjectkit-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host localhost",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc -b && vite build",
