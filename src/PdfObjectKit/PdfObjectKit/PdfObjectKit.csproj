<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(CurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(CurrentVersion)</Version>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>PdfObjectKit</PackageId>
    <Authors>Phong Nguyen</Authors>
    <Description>A dependency-free .NET library for reading, editing, and writing PDF object graphs, JSON conversion, and text, image, paragraph, and Markdown extraction.</Description>
    <PackageTags>pdf;pdf-parser;pdf-editor;json;markdown</PackageTags>
    <PackageProjectUrl>https://github.com/phongnguyend/Practical.Pdf/tree/main/src/PdfObjectKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phongnguyend/Practical.Pdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
